<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>dshl</AssemblyName>
    <Version>0.1.11</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>DSH Launcher</AssemblyTitle>
    <Product>DSH Launcher</Product>
    <Description>DeepSeek Harness の起動・停止・状態確認（GUI + CLI）</Description>
    <RootNamespace>DshLauncher</RootNamespace>
    <StartupObject>DshLauncher.Program</StartupObject>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>embedded</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>


